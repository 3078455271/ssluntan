# 复制为 .env 后修改
APP_NAME=SSluntan
ENVIRONMENT=development
DEBUG=true

# 前后端分离
API_PREFIX=/api
# 旧的 Jinja 服务端渲染页面，仅兼容用；前后端分离时保持 false
ENABLE_LEGACY_WEB_UI=false

# 用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
SECRET_KEY=change-me-to-a-random-48-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 默认使用 SQLite；切换 PostgreSQL 时改成：
# DATABASE_URL=postgresql+asyncpg://forum:forum@localhost:5432/forum
DATABASE_URL=sqlite+aiosqlite:///./forum.db
AUTO_CREATE_TABLES=true
SEED_DEFAULT_DATA=true

COOKIE_SECURE=false
SESSION_COOKIE_NAME=forum_session
CSRF_COOKIE_NAME=forum_csrf

# 逗号分隔；前端域名，例如 http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173